# Copy this file to .env and create an Azure Speech resource.
# Live microphone audio is sent to Azure Speech for pronunciation assessment.
AZURE_SPEECH_KEY=replace-with-your-speech-resource-key
AZURE_SPEECH_REGION=replace-with-your-speech-resource-region

# OpenRouter chat fallback: the key is shared across many free models.
# You do not choose a model on the key itself; each request chooses a model.
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODELS=openai/gpt-oss-20b:free,meta-llama/llama-3.1-8b-instruct:free,google/gemma-3-4b-it:free,mistralai/mistral-7b-instruct:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Nūr

# Optional: enable HTTPS with a certificate trusted by your browser/device.
# TLS_KEY_PATH=C:\path\to\private-key.pem
# TLS_CERT_PATH=C:\path\to\certificate.pem
